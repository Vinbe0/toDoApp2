{
  "name": "todoapp2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env PORT=3000 npm run dev --prefix server",
    "dev:all": "concurrently -n web,api -c green,blue \"npm run dev\" \"npm run dev:server\"",
    "setup": "npm install && npm install --prefix server",
    "build": "vue-tsc --build && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write src/ *.ts index.html",
    "format:check": "prettier --check src/ *.ts index.html",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.0.3",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
