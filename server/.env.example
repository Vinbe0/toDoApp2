PORT=3000
# Required in production; a random string of at least 32 characters.
JWT_SECRET=change-me
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Database: leave DATABASE_URL unset to use the embedded PGlite database
# stored in PGLITE_DATA_DIR. Set it to use a real PostgreSQL server, e.g.
# the one from docker-compose.yml:
# DATABASE_URL=postgres://todos:todos@localhost:5433/todos
PGLITE_DATA_DIR=.data/pglite
